# Supabase (https://supabase.com -> New project -> Settings -> API)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Razorpay (https://dashboard.razorpay.com -> Settings -> API Keys -> Test Mode)
VITE_RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXX

# Server-side only (Vercel Project Settings -> Environment Variables. NEVER expose in client)
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
